<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>📈 Отчеты</title>

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2">
    </script>

    <style>
        /* ===== APPLE STYLE ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Helvetica Neue", sans-serif;
            background: #f5f5f7;
            color: #1d1d1f;
            padding: 20px;
            display: flex;
            justify-content: center;
            min-height: 100vh;
        }

        .container {
            max-width: 1100px;
            width: 100%;
            background: #ffffff;
            border-radius: 28px;
            padding: 28px 30px 36px;
            box-shadow: 0 12px 48px rgba(0, 0, 0, 0.06);
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 14px;
            border-bottom: 1px solid #e5e5ea;
            margin-bottom: 22px;
            flex-wrap: wrap;
            gap: 10px;
        }

        .logo {
            font-size: 20px;
            font-weight: 600;
            letter-spacing: -0.5px;
            color: #1d1d1f;
        }
        .logo span {
            font-weight: 300;
            color: #86868b;
        }

        .nav {
            display: flex;
            gap: 4px;
            flex-wrap: wrap;
        }
        .nav a {
            padding: 6px 14px;
            border-radius: 18px;
            font-size: 13px;
            font-weight: 500;
            color: #1d1d1f;
            text-decoration: none;
            transition: all 0.2s ease;
            background: #f5f5f7;
        }
        .nav a:hover {
            background: #e5e5ea;
        }
        .nav a.active {
            background: #007aff;
            color: #ffffff;
            box-shadow: 0 2px 10px rgba(0, 122, 255, 0.25);
        }

        .status-badge {
            font-size: 12px;
            color: #34c759;
            background: #e8f9ed;
            padding: 3px 12px;
            border-radius: 18px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 5px;
            white-space: nowrap;
        }
        .status-badge .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #34c759;
            display: inline-block;
        }
        .status-badge.error {
            color: #ff3b30;
            background: #fde8e8;
        }
        .status-badge.error .dot {
            background: #ff3b30;
        }

        .page-title {
            font-size: 26px;
            font-weight: 700;
            letter-spacing: -0.5px;
            margin-bottom: 4px;
        }
        .page-subtitle {
            font-size: 16px;
            color: #86868b;
            margin-bottom: 22px;
        }

        /* ===== ФИЛЬТРЫ ===== */
        .filter-card {
            background: #f8f8fa;
            border-radius: 16px;
            padding: 16px 20px;
            border: 1px solid #e5e5ea;
            margin-bottom: 18px;
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            align-items: flex-end;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 3px;
            flex: 1;
            min-width: 150px;
        }
        .filter-group label {
            font-size: 12px;
            font-weight: 600;
            color: #86868b;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }
        .filter-group input,
        .filter-group select {
            padding: 8px 14px;
            border: 1.5px solid #d2d2d6;
            border-radius: 12px;
            font-size: 14px;
            font-family: inherit;
            background: #ffffff;
            transition: border-color 0.2s;
            width: 100%;
        }
        .filter-group input:focus,
        .filter-group select:focus {
            outline: none;
            border-color: #007aff;
            box-shadow: 0 0 0 4px rgba(0, 122, 255, 0.1);
        }

        .btn-primary {
            padding: 8px 20px;
            border: none;
            border-radius: 12px;
            background: #007aff;
            color: #ffffff;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            font-family: inherit;
            height: 44px;
            white-space: nowrap;
        }
        .btn-primary:hover {
            background: #0066d9;
        }

        .btn-success {
            padding: 8px 20px;
            border: none;
            border-radius: 12px;
            background: #34c759;
            color: #ffffff;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            font-family: inherit;
            height: 44px;
            white-space: nowrap;
        }
        .btn-success:hover {
            background: #28a745;
        }
        .btn-success:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .btn-outline {
            padding: 8px 18px;
            border: 1.5px solid #d2d2d6;
            border-radius: 12px;
            background: #ffffff;
            font-size: 14px;
            font-weight: 500;
            color: #1d1d1f;
            cursor: pointer;
            transition: all 0.2s;
            font-family: inherit;
            height: 44px;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .btn-outline:hover {
            border-color: #007aff;
            background: #f5f9ff;
        }

        .filter-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        /* ===== ТАБЛИЦА ===== */
        .table-wrapper {
            background: #f8f8fa;
            border-radius: 16px;
            border: 1px solid #e5e5ea;
            overflow: hidden;
        }

        .table-scroll {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }

        thead {
            background: #f0f0f2;
        }

        th {
            padding: 10px 16px;
            text-align: left;
            font-weight: 600;
            color: #86868b;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            border-bottom: 1px solid #e5e5ea;
            white-space: nowrap;
        }

        td {
            padding: 10px 16px;
            border-bottom: 1px solid #e5e5ea;
            color: #1d1d1f;
        }

        tr:last-child td {
            border-bottom: none;
        }

        .text-right {
            text-align: right;
        }
        .text-green {
            color: #34c759;
        }
        .text-red {
            color: #ff3b30;
        }
        .text-gray {
            color: #86868b;
        }
        .fw-bold {
            font-weight: 600;
        }

        .category-badge {
            display: inline-block;
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 500;
        }
        .category-badge.постоянные {
            background: #e8f9ed;
            color: #34c759;
        }
        .category-badge.поддоны {
            background: #fff5e6;
            color: #ff9500;
        }
        .category-badge.коробки {
            background: #e8f0fe;
            color: #007aff;
        }
        .category-badge.склад {
            background: #f5e6ff;
            color: #af52de;
        }

        .empty-state {
            text-align: center;
            padding: 40px;
            color: #86868b;
        }

        /* ===== ТОТАЛЫ ===== */
        .totals-row {
            display: flex;
            justify-content: flex-end;
            gap: 24px;
            flex-wrap: wrap;
            margin-top: 14px;
            font-size: 14px;
            color: #86868b;
        }
        .totals-row strong {
            color: #1d1d1f;
        }

        .toast {
            position: fixed;
            bottom: 30px;
            right: 30px;
            padding: 14px 22px;
            border-radius: 14px;
            background: #1d1d1f;
            color: #ffffff;
            font-size: 14px;
            font-weight: 500;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
            transform: translateY(80px);
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 1000;
            max-width: 380px;
        }
        .toast.show {
            transform: translateY(0);
            opacity: 1;
        }
        .toast.success {
            background: #34c759;
        }
        .toast.error {
            background: #ff3b30;
        }
        .toast.info {
            background: #007aff;
        }

        @media (max-width: 768px) {
            body {
                padding: 12px;
            }
            .container {
                padding: 18px 14px;
                border-radius: 20px;
            }
            .header {
                flex-direction: column;
                align-items: flex-start;
            }
            .nav {
                width: 100%;
                justify-content: flex-start;
            }
            .nav a {
                font-size: 12px;
                padding: 5px 10px;
            }
            .page-title {
                font-size: 22px;
            }
            .filter-card {
                flex-direction: column;
                align-items: stretch;
                padding: 14px 16px;
            }
            .filter-actions {
                flex-direction: column;
            }
            .filter-actions .btn-primary,
            .filter-actions .btn-success,
            .filter-actions .btn-outline {
                width: 100%;
                justify-content: center;
            }
            .totals-row {
                justify-content: flex-start;
                gap: 12px;
            }
        }

        @media (max-width: 480px) {
            .container {
                padding: 12px 10px;
            }
            th,
            td {
                padding: 8px 10px;
                font-size: 12px;
            }
        }
    </style>
</head>
<body>

    <div class="container">

        <!-- ===== ХЕДЕР ===== -->
        <header class="header">
            <div class="logo">📦 <span>Учет материалов</span></div>
            <nav class="nav">
                <a href="index.html">📋 Отгрузка</a>
                <a href="dashboard.html">📊 Дашборд</a>
                <a href="balances.html">✏️ Остатки</a>
                <a href="reports.html" class="active">📈 Отчеты</a>
            </nav>
            <div class="status-badge" id="statusBar">
                <span class="dot"></span>
                <span id="connectionStatus">Подключение...</span>
            </div>
        </header>

        <!-- ===== ЗАГОЛОВОК ===== -->
        <h1 class="page-title">📈 Отчет по остаткам</h1>
        <p class="page-subtitle">Актуальные остатки всех материалов с возможностью выгрузки</p>

        <!-- ===== ФИЛЬТРЫ ===== -->
        <div class="filter-card">
            <div class="filter-group">
                <label for="reportCategory">📂 Категория</label>
                <select id="reportCategory">
                    <option value="">Все категории</option>
                    <option value="ПОСТОЯННЫЕ">Постоянные</option>
                    <option value="Поддоны">Поддоны</option>
                    <option value="Коробки">Коробки</option>
                    <option value="СКЛАД">Склад</option>
                </select>
            </div>
            <div class="filter-actions">
                <button class="btn-primary" onclick="generateReport()">🔄 Сформировать</button>
                <button class="btn-success" id="exportBtn" onclick="downloadCSV()">📤 Скачать CSV</button>
                <button class="btn-outline" onclick="window.location.href='dashboard.html'">📊 На дашборд</button>
            </div>
        </div>

        <!-- ===== ТАБЛИЦА ===== -->
        <div class="table-wrapper">
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Материал</th>
                            <th>Категория</th>
                            <th class="text-right">Остаток</th>
                            <th class="text-right">Ед. изм.</th>
                        </tr>
                    </thead>
                    <tbody id="reportBody">
                        <tr>
                            <td colspan="5" class="empty-state">
                                ⏳ Нажмите «Сформировать» для загрузки отчета
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ===== ИТОГО ===== -->
        <div class="totals-row" id="totalsRow">
            <span>📦 Всего материалов: <strong id="totalMaterials">0</strong></span>
            <span>📦 Суммарный остаток: <strong id="totalBalance">0</strong></span>
        </div>

    </div>

    <!-- ===== TOAST ===== -->
    <div class="toast" id="toast"></div>

    <!-- ========================================== -->
    <!-- СКРИПТЫ -->
    <!-- ========================================== -->
    <script>
        var SUPABASE_URL = 'https://nlthrnqhwqetkggzrbpy.supabase.co';
        var SUPABASE_ANON_KEY =
            'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5sdGhybnFod3FldGtnZ3pyYnB5Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4Nzg0NTcxNywiZXhwIjoyMTAzNDIxNzE3fQ.TtvprePUVmHRfexGhX0YTjttxf57iMNoWUmIJ-TMPPw';

        if (typeof window.supabaseClient === 'undefined') {
            window.supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
        }
        var supabase = window.supabaseClient;

        var reportData = [];
        var allMaterials = [];

        document.addEventListener('DOMContentLoaded', function() {
            checkConnection();
            loadMaterials();
        });

        function checkConnection() {
            var statusEl = document.getElementById('connectionStatus');
            var bar = document.getElementById('statusBar');

            supabase.from('materials').select('count').limit(1)
                .then(function(result) {
                    if (result.error) throw result.error;
                    statusEl.textContent = 'Подключено';
                    bar.className = 'status-badge';
                })
                .catch(function(error) {
                    console.error('Ошибка:', error);
                    statusEl.textContent = 'Ошибка';
                    bar.className = 'status-badge error';
                });
        }

        function loadMaterials() {
            supabase.from('materials').select('*').order('category').order('name')
                .then(function(result) {
                    if (result.error) throw result.error;
                    allMaterials = result.data;
                })
                .catch(function(error) {
                    console.error('Ошибка загрузки материалов:', error);
                });
        }

        function generateReport() {
            var category = document.getElementById('reportCategory').value;
            var tbody = document.getElementById('reportBody');
            tbody.innerHTML = '<tr><td colspan="5" class="empty-state">⏳ Загрузка...</td></tr>';

            supabase.from('movements').select('material_id, quantity, movement_type')
                .then(function(result) {
                    if (result.error) throw result.error;

                    var balances = {};
                    for (var i = 0; i < result.data.length; i++) {
                        var row = result.data[i];
                        if (!balances[row.material_id]) balances[row.material_id] = 0;
                        if (row.movement_type === 'INCOME') {
                            balances[row.material_id] += row.quantity;
                        } else {
                            balances[row.material_id] -= row.quantity;
                        }
                    }

                    reportData = [];
                    var filteredMaterials = allMaterials;

                    if (category) {
                        filteredMaterials = allMaterials.filter(function(m) {
                            return m.category === category;
                        });
                    }

                    var totalBalance = 0;

                    for (var j = 0; j < filteredMaterials.length; j++) {
                        var mat = filteredMaterials[j];
                        var balance = balances[mat.id] || 0;
                        totalBalance += balance;

                        reportData.push({
                            code: mat.code,
                            name: mat.name,
                            category: mat.category || '—',
                            unit: mat.unit || 'шт',
                            balance: balance
                        });
                    }

                    renderReport();
                    document.getElementById('totalMaterials').textContent = reportData.length;
                    document.getElementById('totalBalance').textContent = formatNumber(totalBalance);
                    document.getElementById('exportBtn').disabled = false;
                    showToast('✅ Отчет сформирован', 'success');
                })
                .catch(function(error) {
                    console.error('Ошибка:', error);
                    tbody.innerHTML =
                        '<tr><td colspan="5" class="empty-state">❌ Ошибка загрузки: ' + error.message +
                    '</td></tr>';
                    showToast('❌ Ошибка: ' + error.message, 'error');
                });
        }

        function renderReport() {
            var tbody = document.getElementById('reportBody');

            if (reportData.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="empty-state">📭 Нет данных</td></tr>';
                return;
            }

            var html = '';
            for (var i = 0; i < reportData.length; i++) {
                var r = reportData[i];
                var categoryClass = (r.category || '').toLowerCase();

                html += '<tr>' +
                    '<td>' + (i + 1) + '</td>' +
                    '<td><span style="font-weight:500;">' + r.name + '</span><br><span style="font-size:11px;color:#86868b;font-family:monospace;">' +
                    r.code + '</span></td>' +
                    '<td><span class="category-badge ' + categoryClass + '">' + r.category + '</span></td>' +
                    '<td class="text-right fw-bold">' + formatNumber(r.balance) + '</td>' +
                    '<td class="text-right text-gray">' + r.unit + '</td>' +
                    '</tr>';
            }

            tbody.innerHTML = html;
        }

        function downloadCSV() {
            if (reportData.length === 0) {
                showToast('⚠️ Сначала сформируйте отчет', 'info');
                return;
            }

            var headers = ['Код', 'Материал', 'Категория', 'Остаток', 'Ед.изм.'];
            var rows = [];

            for (var i = 0; i < reportData.length; i++) {
                var r = reportData[i];
                rows.push([r.code, r.name, r.category, r.balance, r.unit]);
            }

            var csv = headers.join(',') + '\n';
            for (var j = 0; j < rows.length; j++) {
                var row = rows[j];
                var escapedRow = row.map(function(cell) {
                    if (typeof cell === 'string' && cell.includes(',')) {
                        return '"' + cell + '"';
                    }
                    return cell;
                });
                csv += escapedRow.join(',') + '\n';
            }

            var blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
            var link = document.createElement('a');
            var now = new Date();
            var dateStr = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate())
                .padStart(2, '0');
            link.href = URL.createObjectURL(blob);
            link.download = 'отчет_остатков_' + dateStr + '.csv';
            link.click();
            URL.revokeObjectURL(link.href);

            showToast('📥 CSV файл скачан', 'success');
        }

        function formatNumber(num) {
            if (num === undefined || num === null) return '0';
            if (Number.isInteger(num)) return num.toString();
            return num.toFixed(3).replace(/\.?0+$/, '');
        }

        function showToast(message, type) {
            type = type || 'info';
            var toast = document.getElementById('toast');
            toast.textContent = message;
            toast.className = 'toast ' + type;
            setTimeout(function() { toast.classList.add('show'); }, 10);
            clearTimeout(toast._timeout);
            toast._timeout = setTimeout(function() { toast.classList.remove('show'); }, 3000);
        }
    </script>

</body>
</html>
